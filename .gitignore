# 依赖与构建产物
node_modules/
public/
.deploy_git/
db.json

# 放在仓库里但与站点无关的软件目录（例如 Hexo Pro Desktop 客户端，600+ MB）
# 只忽略，不删除；磁盘上的文件保持原样
HexoPro/
data/
blogInfoList.json

# 本地备份（原图、被替换页面的 .bak 等）：留在磁盘上，不进仓库
backup/

# 万一以后用到：任何形式的密钥/凭据都不要提交
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
*_rsa

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak

# Python 运行产物（tools/ 下跑脚本会生成，例如 py -3 -m py_compile）
__pycache__/
*.pyc

# Hexo Pro 客户端自己的东西：模板目录与「丢弃区」（被丢弃的文件会移到这里）
_yaml_templates/
source/_discarded/

# Hexo Pro 客户端的部署设置（它还会顺带重写 _config.yml，见手册）
deploy_config.json

# HexoHub 客户端（现在装在仓库外面 D:\tools\HexoHub，见手册 13.4）
# 这两行只是保险：万一客户端又被放进仓库目录，也不会被提交
HexoHub/
HexoHub*.exe

# 客户端生成的空配置（曾被误提交，已清理）
_admin-config.yml
