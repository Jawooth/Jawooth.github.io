# 依赖与构建产物
node_modules/
public/
.deploy_git/
db.json

# 放在仓库里但与站点无关的软件目录（例如 Hexo Pro Desktop 客户端，600+ MB）
# 只忽略，不删除；磁盘上的文件保持原样
HexoPro/
data/
blogInfoList.json

# 本地备份（原图、被替换页面的 .bak 等）：留在磁盘上，不进仓库
backup/

# 万一以后用到：任何形式的密钥/凭据都不要提交
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
*_rsa

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak

# Python 运行产物（tools/ 下跑脚本会生成，例如 py -3 -m py_compile）
__pycache__/
*.pyc

# Hexo Pro 客户端自己的东西：模板目录与「丢弃区」（被丢弃的文件会移到这里）
_yaml_templates/
source/_discarded/

# Hexo Pro 客户端的部署设置（它还会顺带重写 _config.yml，见 README.md 第 10 节）
deploy_config.json

# HexoHub 客户端（现在装在仓库外面 D:\tools\HexoHub，见 README.md 第 10 节）
# 这两行只是保险：万一客户端又被放进仓库目录，也不会被提交
HexoHub/
HexoHub*.exe

# 客户端生成的空配置（曾被误提交，已清理）
_admin-config.yml

# DSH 沙箱排查时留下的 ACL 审计记录（2026-10-18）
# 只有记录、不含站点内容；真要留证据就挪进 backup\，别放在仓库根目录显眼处
.acl-recovery/

# 调试用的截图与临时产物：留在磁盘上，不进仓库
# （截图是排查问题时留的证据，重新截一次就有；83 MB 进仓库没意义）
.screenshots/
tools/shots/
tools/icons/preview/
tools/icons/_edge-hl/
tools/icons/_edge-hl2/
tools/icons/*.png
tools/fonts/*.png

# 工具脚本的临时备份与中间产物
scripts/*.pixel-backup.js
tools/_*.js
tools/_*.py
_favicon_*.png

# 无头浏览器的临时 profile（跑 tools/check 里的探针时生成）
# 放在仓库内是因为 Edge 拿不到 %TEMP% 的 ACL 就起不来；profile 体积很大，别进仓库
.edge-audit/
.edge-probe*/
.tmp-edge/
# 图标工坊的调试脚本与预览页（临时验证用，重跑就有）
tools/icons/_*.js
tools/icons/_*.html
tools/icons/preview.html

# 工作目录里的助手笔记（.workbuddy/memory 下的每日工作日志）
# 只服务本机接续，不是站点内容，别跟着仓库一起公开
.workbuddy/
