# 依赖与构建产物
node_modules/
public/
.deploy_git/
db.json

# 放在仓库里但与站点无关的软件目录（例如 Hexo Pro Desktop 客户端，600+ MB）
# 只忽略，不删除；磁盘上的文件保持原样
HexoPro/
data/
blogInfoList.json

# 本地备份（原图、被替换页面的 .bak 等）：留在磁盘上，不进仓库
backup/

# 万一以后用到：任何形式的密钥/凭据都不要提交
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
*_rsa

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak
