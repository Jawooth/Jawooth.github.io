<div class="site-header-container">
  <div class="site-header">
    <div class="left">
      <a href="<%= url_for(config.url) %>">
        <img class="avatar" src="<%= url_for(theme.avatar) %>" alt="logo" width="32px" height="32px">
      </a>
      <a href="<%= url_for(config.url) %>">
        <h1 class="site-title"><%= config.title %></h1>
      </a>
    </div>
    <div class="right">
        <i class="icon menu-switch icon-menu-outline" ></i>
    </div>
  </div>
</div>

<div class="menu-container" style="height: 0;opacity: 0;">
  <% /* 这个折叠菜单对应的顶栏开关（.menu-switch）在 xp-custom.css 里是 display:none，
         菜单实际走任务栏「开始菜单」，所以这里整块对用户不可见。以前这 5 个链接仍是
         tabindex=0，键盘 Tab 前 5 下全落在看不见的元素上（审查确认）。加了 tabindex="-1"
         让它们既不可聚焦也不进 Tab 序（DOM 保留，哪天要重新挂接还在）。 */ %>
<nav class="menu-list" aria-hidden="true">
  <% Object.keys(theme.menu).forEach(function(key) { %>
    <% /* External: true（本仓库 _config.minimalism.yml 的写法）或 openType: 'External'（主题旧写法）都认，否则外链的「新标签页打开」会静默失效 */ if (theme.menu[key].External === true || theme.menu[key].openType === 'External') { %>
      <a class="menu purple-link" href="<%= url_for(theme.menu[key].url) %>" target="_blank" rel="noopener noreferrer" tabindex="-1">
        <%= theme.menu[key].name %>
      </a>
    <% } else { %>
      <a href="<%= url_for(theme.menu[key].url) %>" class="menu purple-link" tabindex="-1">
        <%= theme.menu[key].name %>
      </a>
    <% } %>
  <% }); %>
</nav>
</div>
