<%#
  文字列表页（/blog/）—— 原「杂谈」与「文章」两个分区在 2026-10-18 合并成这一页
  ------------------------------------------------------------------
  XP 窗口外壳 + 带封面的文章卡片流 + 侧栏，底部注入待办窗口。
  卡片流由 scripts/xp-content.js 的 xp_post_cards helper 生成。
%><%- include('./includes/header') %>

  <div class="content-container xp-shell">
    <%- include('./includes/xp-window-title', { title: '文字 · 全部文章', h1: true }) %>

    <div class="post-info">
      <%# 'essays' = 排掉「作品」之后的篇数（和 post-hide.js 里 index 生成器的过滤一致）；
          用 'posts' 会把作品也算进来，头部就会写着一个和卡片数对不上的数字。 %>
      <span><i class="icon icon-menu-outline"></i> 共 <%= xp_num_of('essays') %> 篇</span>
      <% if (page.total > 1) { %>
        <span>第 <%= page.current %> / <%= page.total %> 页</span>
      <% } %>
    </div>

    <div class="xp-shell-body">
      <div class="xp-shell-main">
        <%- xp_widget_todo(0) %>
        <%- xp_post_cards(page.posts) %>

        <%- include('./includes/xp-pagination') %>
      </div>

      <%- include('./includes/xp-aside', { page: page, isPost: false }) %>
    </div>
  </div>

<%- include('./includes/footer') %>
