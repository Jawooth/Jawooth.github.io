.main {
  max-width: 768px;
  margin: 0 auto;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}

.content-container {
  width: 100%;
  flex: 1;
  padding: 46px 16px 32px;
}

.post-info {
  color: var(--c-base-purple);
  font-size: 16px;
  margin-top 10px
  span {
    margin-right: 16px;
  }
  .icon {
    font-size: 12px;
    margin-right: 4px;
  }
  a {
    color: var(--c-base-purple);
  }
}

nav {
  overflow: hidden;
}

@media (min-width: 1200px) {
  .main {
    max-width: 1000px;
  }
  .site-header {
    max-width: 1000px;
  }
}
