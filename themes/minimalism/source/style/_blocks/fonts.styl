@font-face {
  font-family: "iconfont"; /* Project id 3522054 */
  /* 只保留 woff2 与 woff：eot/svg/ttf 是 IE 时代的兜底格式，
     现代浏览器（含 Edge/Chrome/Firefox/Safari 近十年版本）都走 woff2。
     删掉那三个文件可省 28,398 B，且不再产生无用的请求路径。 */
  src: url('../fonts/iconfont.woff2?t=1724986230549') format('woff2'),
    url('../fonts/iconfont.woff?t=1724986230549') format('woff');
}

.icon {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

