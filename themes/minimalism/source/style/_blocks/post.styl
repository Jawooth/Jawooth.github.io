.post-content {
  flex-shrink: 0;
  width: 100%;
  h1, h2, h3, h4, h5, h6 {
    padding: 16px 0;
    color: #0C1E29;
  }

  a {
    word-break: break-all;
    color: #0e78db;
    font-weight: 600;
    transition: all 0.2s;
  }
  a:hover {
    color: #0081f9;
    text-decoration: underline;
  }
  img {
    display: block;
    box-shadow: 0 0 30px #eee;
    max-width: 100%;
    border-radius: 2px;
    margin: 16px auto;
  }

  p {
    line-height: 1.725;
    margin-bottom: 16px;
    color: var(--c-base-blacklight);

    code {
      color: #858080;
      padding: 0 3px;
      margin: 2px 2px;
      background-color: #f9fafa;
      border: 1px solid #e4e4e4;
      font-size: 16px;
      display: inline-block;
      border-radius: 4px;
      max-width: 740px;
    }
  }

  code {
    color: #476582;
    padding: .16rem .5rem;
    margin: 0.25rem 0;
    font-size: 16px;
    background-color: rgba(27,31,35,.05);
    border-radius: 3px;
    display: inline-block;
  }

  blockquote {
    background: #f3f5f7;
    padding: 16px;
    border-left: 2px solid var(--c-base-purple);
    margin-bottom: 16px;
    p {
      margin-bottom: 0;
    }
  }

  pre {
    margin-bottom: 16px;
    code {
      font-size: 16px;
      font-family: 'Source Code Pro', Consolas, Menlo, Monaco, 'Courier New', monospace;
      padding: 2em 1em 1em;
      border-radius: 5px;
      line-height: 1.375;
      position: relative;
      background: #fafafa;
      display: block;
      &:after {
        content: attr(data-content-after);
        display: block;
        position: absolute;
        left: 8px;
        top: 4px;
        font-size: 16px;
        font-weight: bold;
        color: #ccc;
      }

    }

    &:hover .copy-code {
      display: block;
    }
    .copy-code {
      cursor: pointer;
      display: none;
      position: absolute;
      right: 8px;
      top: 4px;
      font-size: 24px;
      color: #9a9a9a;
      .copy-success {
        font-size: 16px;
      }
    }

  }

  pre[class*=language-].line-numbers {
    position: relative;
  }

  table {
    border-collapse: collapse;
    //margin: 1rem 0;
    //display: block;
    overflow-x: auto;
    display table
    margin 1rem auto
  }
  figure {
    table {
      margin: 1rem 0;
      display: block;
    }
  }
  tr {
    border-top: 1px solid #dfe2e5;
    transition: 500ms;
  }
  td, th {
    border: 1px solid #dfe2e5;
    padding: .4em;
    line-height: 1.2em;
  }
  tr:hover {
    background-color: #f8f8f8;
  }

  ul, ol {
    color: var(--c-base-blacklight);
    padding-left: 24px;
    line-height: 1.725;
    margin-bottom: 16px;
  }

  strong {
    font-weight: bolder;
  }
}

.post-content-wrapper {
  display: flex;
}

@media (max-width: 1400px) {
  .top-box {
    display: none;
  }
  #gitalk-container {
    width: 94%;
    margin: 0 auto;
  }
  #twikoo {
    width: 94%;
    margin: 0 auto;
  }
}
#twikoo {
  .tk-content {
    overflow-y hidden
  }
  p {
    margin: revert;
  }
}

/* 原 .top-div / .top-box / .top-box-child 侧栏目录样式：主题旧版 TOC 用的，
   现在目录由 scripts/xp-content.js 渲染成 XP 窗口，这些类没有任何页面在用，故删。
   同时删掉 .github-emoji / .github-emoji-fallback（GitHub 表情解析从未启用）。 */

