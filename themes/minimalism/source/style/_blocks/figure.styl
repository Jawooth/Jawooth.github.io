.highlight {
  margin-bottom: 16px;
  font-size: 16px;
  font-family: 'Source Code Pro', Consolas, Menlo, Monaco, 'Courier New', monospace;
  padding: 2em 1em 1em;
  border-radius: 5px;
  line-height: 1.375;
  position: relative;
  background: #fafafa;
  color: #476582;
  display: block;
  table,th,tr,td,pre {
    border: none;
    margin: 0;
    padding: 0;
  }
  .gutter { // 行号不显示，见 _config.yml highlight.line_number: false（不发射行号结构）
    display: none;
  }
  .code {
    display: flex;
  }
  &:after {
    content: attr(data-content-after);
    display: block;
    position: absolute;
    left: 8px;
    top: 4px;
    font-size: 16px;
    font-weight: bold;
    // #ccc 在 #fafafa 底上只有 1.54:1，WCAG AA 不达标（浅色模式仔细看几乎看不清）。
    // 沿用代码正文色 #476582，_config.yml highlight.line_number:false 后这是语言标签唯一落点。
    color: #476582;
  }
  &:hover .copy-code {
    display: block;
  }
  .copy-code {
    cursor: pointer;
    display: none;
    position: absolute;
    right: 8px;
    top: 4px;
    font-size: 24px;
    color: #9a9a9a;
    .copy-success {
      font-size: 16px;
    }
  }
}